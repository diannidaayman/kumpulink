# Kumpulink — daftar variabel lingkungan.
#
# Berkas ini hanya memuat NAMA, tidak pernah nilainya. Salin menjadi
# .env.local lalu isi nilainya di sana; .env.local diabaikan Git.
#
# Cara memperoleh tiap nilai ada di docs/setup-layanan.md.

# --- Neon (Postgres) ---
# DATABASE_URL memakai connection string ter-pool, dipakai aplikasi.
# DIRECT_URL memakai koneksi langsung, dipakai migrasi Prisma.
DATABASE_URL=
DIRECT_URL=

# --- Auth.js ---
# AUTH_SECRET dibuat lokal, bukan diambil dari konsol mana pun.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Peran pemilik ---
# Satu-satunya penentu peran OWNER. Tidak ada antarmuka untuk
# mengubahnya, dan nilainya harus cocok persis dengan alamat Google
# yang dipakai masuk.
OWNER_EMAIL=

# --- Vercel Blob (private store) ---
# BLOB_READ_WRITE_TOKEN hanya diperlukan kode yang berjalan di luar
# Vercel, termasuk mesin pengembangan lokal. Di atas Vercel,
# autentikasinya memakai OIDC.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# --- Resend ---
# EMAIL_FROM harus berada pada domain yang sudah terverifikasi di
# Resend. Domain uji resend.dev hanya dapat mengirim ke alamat pemilik
# akun, jadi tidak cukup untuk email keputusan yang ditujukan ke pemohon.
RESEND_API_KEY=
EMAIL_FROM=

# --- Endpoint terjadwal ---
# Dikirim sebagai header oleh workflow GitHub Actions. Endpoint cron
# menolak permintaan tanpa header ini. Dibuat lokal.
CRON_SECRET=
